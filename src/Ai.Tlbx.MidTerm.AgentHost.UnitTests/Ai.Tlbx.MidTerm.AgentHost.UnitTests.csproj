<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Tests call APIs in the self-contained server and build host executables. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ai.Tlbx.MidTerm.AgentHost\Ai.Tlbx.MidTerm.AgentHost.csproj" />
    <ProjectReference Include="..\Ai.Tlbx.MidTerm.FakeCodex\Ai.Tlbx.MidTerm.FakeCodex.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Ai.Tlbx.MidTerm.FakeClaude\Ai.Tlbx.MidTerm.FakeClaude.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\FakeCodexPathScope.cs" Link="FakeCodexPathScope.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\FakeClaudePathScope.cs" Link="FakeClaudePathScope.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\FakeCodexWebSocketServer.cs" Link="FakeCodexWebSocketServer.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\AppServerControlHostProtocolTests.cs" Link="AppServerControlHostProtocolTests.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\AppServerControlHostTestClient.cs" Link="AppServerControlHostTestClient.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\MtAgentHostTestPathResolver.cs" Link="MtAgentHostTestPathResolver.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\MtAgentHostCodexIntegrationTests.cs" Link="MtAgentHostCodexIntegrationTests.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\MtAgentHostClaudeIntegrationTests.cs" Link="MtAgentHostClaudeIntegrationTests.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\MtAgentHostIntegrationTests.cs" Link="MtAgentHostIntegrationTests.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\PathSensitiveEnvironmentCollection.cs" Link="PathSensitiveEnvironmentCollection.cs" />
    <Compile Include="..\Ai.Tlbx.MidTerm.UnitTests\TestExecutablePathResolver.cs" Link="TestExecutablePathResolver.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
