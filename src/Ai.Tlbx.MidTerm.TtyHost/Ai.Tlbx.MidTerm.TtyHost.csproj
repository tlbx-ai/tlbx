<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>mthost</AssemblyName>
    <RootNamespace>Ai.Tlbx.MidTerm.TtyHost</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RuntimeIdentifiers>win-x64;win-x86;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ConptyNativePlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</ConptyNativePlatform>
    <ConptyNativePlatform Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</ConptyNativePlatform>
    <ConptyNativePlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</ConptyNativePlatform>
    <ConptyRequiresx86Host Condition="'$(RuntimeIdentifier)' == 'win-x86'">true</ConptyRequiresx86Host>
    <ConptyRequiresx64Host Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-x64'">true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64'">true</ConptyRequiresARM64Host>
    <!-- Version is set dynamically from version.json via ReadVersionJson target -->
  </PropertyGroup>

  <!-- Read version from version.json - single source of truth -->
  <Target Name="ReadVersionJson" BeforeTargets="GetAssemblyVersion;BeforeCompile">
    <Exec Command="node -p &quot;require('./src/version.json').pty&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/../.." ConsoleToMsBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="PtyVersion" />
    </Exec>
    <PropertyGroup>
      <Version>$(PtyVersion)</Version>
    </PropertyGroup>
    <!-- Generate Version.g.cs with the version string -->
    <PropertyGroup>
      <VersionGenFile>$(IntermediateOutputPath)Version.g.cs</VersionGenFile>
      <VersionGenContent>namespace Ai.Tlbx.MidTerm.TtyHost%3B internal static class VersionInfo { public const string Version = "$(PtyVersion)"%3B }</VersionGenContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionGenFile)" Lines="$(VersionGenContent)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(VersionGenFile)" />
    </ItemGroup>
  </Target>

  <!-- Publish-only: AOT optimizations -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and '$(IsPublishing)' == 'true'">
    <OptimizationPreference>Speed</OptimizationPreference>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
    <IlcDisableReflection>true</IlcDisableReflection>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <UseSizeOptimizedLinq>false</UseSizeOptimizedLinq>
    <DebuggerSupport>false</DebuggerSupport>
    <DebugType>none</DebugType>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <Http3Support>false</Http3Support>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
  </PropertyGroup>

  <!-- Windows linker optimizations -->
  <ItemGroup Condition="'$(IsPublishing)' == 'true' And $(RuntimeIdentifier.StartsWith('win'))">
    <LinkerArg Include="/OPT:REF" />
    <LinkerArg Include="/OPT:ICF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ai.Tlbx.MidTerm.Common\Ai.Tlbx.MidTerm.Common.csproj" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.260930003" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    Native AOT does not reliably carry the ConPTY package's native sidecars into
    publish output. Keep the package's expected layout explicit so release
    staging cannot silently ship mthost.exe without its Windows PTY runtime.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">
    <None Condition="'$(RuntimeIdentifier)' == 'win-x64'"
          Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-x64\native\conpty.dll"
          Link="conpty.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(RuntimeIdentifier)' == 'win-x86'"
          Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-x86\native\conpty.dll"
          Link="conpty.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(RuntimeIdentifier)' == 'win-x86'"
          Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x86\OpenConsole.exe"
          Link="x86\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86'"
          Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe"
          Link="x64\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86'"
          Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\arm64\OpenConsole.exe"
          Link="arm64\OpenConsole.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">
    <EmbeddedResource Condition="'$(RuntimeIdentifier)' == 'win-x64'"
                      Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-x64\native\conpty.dll"
                      LogicalName="tlbx.conpty.conpty.dll" />
    <EmbeddedResource Condition="'$(RuntimeIdentifier)' == 'win-x86'"
                      Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-x86\native\conpty.dll"
                      LogicalName="tlbx.conpty.conpty.dll" />
    <EmbeddedResource Condition="'$(RuntimeIdentifier)' == 'win-x86'"
                      Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x86\OpenConsole.exe"
                      LogicalName="tlbx.conpty.x86.OpenConsole.exe" />
    <EmbeddedResource Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86'"
                      Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe"
                      LogicalName="tlbx.conpty.x64.OpenConsole.exe" />
    <EmbeddedResource Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-x86'"
                      Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\arm64\OpenConsole.exe"
                      LogicalName="tlbx.conpty.arm64.OpenConsole.exe" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ai.Tlbx.MidTerm.UnitTests" />
  </ItemGroup>

  <!-- Windows application manifest -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(RuntimeIdentifier)' == ''">
    <ApplicationIcon>..\Ai.Tlbx.MidTerm\src\static\favicon\favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationIcon>..\Ai.Tlbx.MidTerm\src\static\favicon\favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Define WINDOWS for Windows builds (both native and cross-compile) -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(RuntimeIdentifier)' == ''">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS_NATIVE_NOTIFICATIONS</DefineConstants>
  </PropertyGroup>

  <!-- Define LINUX for Linux builds -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$(RuntimeIdentifier)' == ''">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Define MACOS for macOS builds -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) AND '$(RuntimeIdentifier)' == ''">
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
</Project>
