<Project>
  <PropertyGroup>
    <_ConnectTransportRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_ConnectTransportRid>
    <_ConnectTransportRid Condition="'$(_ConnectTransportRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_ConnectTransportRid>
    <_ConnectTransportExtension Condition="$(_ConnectTransportRid.StartsWith('win-'))">.exe</_ConnectTransportExtension>
    <_ConnectTransportRoot>$(MSBuildProjectDirectory)/../Ai.Tlbx.MidTerm.ConnectTransport</_ConnectTransportRoot>
    <_ConnectTransportBinary>$(_ConnectTransportRoot)/bin/$(_ConnectTransportRid)/mtconnect$(_ConnectTransportExtension)</_ConnectTransportBinary>
  </PropertyGroup>
  <!-- The companion is transport-only. Embed it so existing single-mt updates
       install the matching WebRTC implementation without another service. -->
  <Target Name="BuildConnectTransport" BeforeTargets="AssignTargetPaths">
    <Exec Command="pwsh -NoProfile -File &quot;$(_ConnectTransportRoot)/build.ps1&quot; -RuntimeIdentifier $(_ConnectTransportRid) -SkipTests" WorkingDirectory="$(_ConnectTransportRoot)" />
    <ItemGroup>
      <EmbeddedResource Include="$(_ConnectTransportBinary)" LogicalName="mtconnect.runtime" />
      <EmbeddedResource Include="$(_ConnectTransportRoot)/bin/$(_ConnectTransportRid)/THIRD-PARTY-NOTICES.txt" LogicalName="mtconnect.notices" />
    </ItemGroup>
    <Error Condition="!Exists('$(_ConnectTransportBinary)')" Text="The matching Connect transport binary is required." />
  </Target>
</Project>
