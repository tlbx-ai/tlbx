# Force LF line endings everywhere (all modern editors handle this fine)
* text=auto eol=lf

# Preserve whitespace inside the upstream SDK's bundled runtime template literals.
src/Ai.Tlbx.MidTerm.AgentHost/ClaudeBridge/dist/claude-agent-sdk-bridge.mjs whitespace=-blank-at-eol
# Unified patches require a leading context marker on empty context lines.
src/Ai.Tlbx.MidTerm/patches/*.patch whitespace=-blank-at-eol
# Native upstream patch context also prefixes tab-indented source with a space.
src/Ai.Tlbx.MidTerm.ConnectNative/ports/*/*.patch whitespace=-blank-at-eol,-space-before-tab
src/Ai.Tlbx.MidTerm.ConnectNative/ports/*/*.diff whitespace=-blank-at-eol,-space-before-tab
src/Ai.Tlbx.MidTerm.ConnectNative/ports/zlib/CVE-2026-85091.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof

# Binary files
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.png binary
*.ico binary
*.gif binary
*.jpg binary
*.jpeg binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
